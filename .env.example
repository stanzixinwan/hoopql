# API connection. SELECT only, statement timeout 5 seconds.
DATABASE_URL=postgresql://hoopql_readonly:hoopql_readonly@localhost:5432/hoopql
# Ingestion connection. Owner of the local Compose database.
ETL_DATABASE_URL=postgresql://hoopql:hoopql@localhost:5432/hoopql

# SQL generator. openai or anthropic; switching providers is this one value.
HOOPQL_LLM_PROVIDER=openai
HOOPQL_OPENAI_MODEL=
HOOPQL_ANTHROPIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
